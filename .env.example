# ============================================================
# ClaimSaathi — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://claimsaathi:claimsaathi_dev@postgres:5432/claimsaathi
DATABASE_URL_SYNC=postgresql://claimsaathi:claimsaathi_dev@postgres:5432/claimsaathi
POSTGRES_USER=claimsaathi
POSTGRES_PASSWORD=claimsaathi_dev
POSTGRES_DB=claimsaathi
# App role (restricted — no UPDATE/DELETE on audit_logs)
DB_APP_ROLE=app_role
DB_APP_ROLE_PASSWORD=CHANGE_ME_app_role_password

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# --- Object Storage (MinIO for local; swap for S3/GCS in prod) ---
STORAGE_BACKEND=minio          # minio | s3 | gcs
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=claimsaathi_minio
MINIO_SECRET_KEY=CHANGE_ME_minio_secret
MINIO_BUCKET_DOCUMENTS=claimsaathi-documents
MINIO_BUCKET_EXPORTS=claimsaathi-exports
MINIO_USE_SSL=false
STORAGE_SIGNED_URL_EXPIRE_SECONDS=900   # 15-minute signed read URLs

# --- LLM Provider ---
LLM_PROVIDER=openai            # openai | gemini | mock
OPENAI_API_KEY=sk-CHANGE_ME
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=CHANGE_ME_if_using_gemini
GEMINI_MODEL=gemini-1.5-pro
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro

# --- Cognee Institutional Memory ---
COGNEE_ENABLED=false
COGNEE_BASE_URL=https://api.cognee.ai
COGNEE_API_KEY=CHANGE_ME_cognee_api_key

# --- Copilot Chat Tuning ---
CHAT_MAX_TOOL_CALLS=5
CHAT_HISTORY_TURNS=12
CHAT_RATE_LIMIT_PER_MIN=20

# --- OCR ---
OCR_ADAPTER=mock               # mock | google_document_ai
GOOGLE_CLOUD_PROJECT=CHANGE_ME
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=CHANGE_ME
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp_credentials.json
OCR_CONFIDENCE_THRESHOLD=0.70  # Below this, ask user for clearer scan

# --- n8n Service Auth (HMAC) ---
# Used for n8n -> backend internal API calls
N8N_SERVICE_SECRET=CHANGE_ME_generate_with_python_secrets_token_hex_32
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
BACKEND_INTERNAL_BASE_URL=http://backend:8000/internal

# --- n8n ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_n8n_password
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# --- Notifications ---
NOTIFICATION_EMAIL_ENABLED=false
SENDGRID_API_KEY=CHANGE_ME_if_using_sendgrid
NOTIFICATION_FROM_EMAIL=noreply@claimsaathi.demo
NOTIFICATION_FROM_NAME=ClaimSaathi

# --- Security ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=5
MAX_UPLOAD_SIZE_MB=25
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp,image/tiff

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json                # json | text

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_DEMO_BADGE=true    # Show "Demo Data" badge on seeded records
