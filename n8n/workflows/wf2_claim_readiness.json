              "value": "All mandatory documents have been verified. You can proceed to submit your claim."
            }
          ]
        },
        "options": {}
      },
      "name": "Notify: Ready",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [960, 220],
